APP_NAME=SuperTraders Journal API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/supertraders_journal

# Firebase Admin SDK (for verifying frontend ID tokens). Put the downloaded JSON in backend/ and point here.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=firebase-adminsdk.json
